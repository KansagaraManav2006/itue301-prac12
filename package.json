{
  "name": "prac12-cicd-github-actions",
  "version": "1.0.0",
  "description": "Practical 12: CI/CD Pipeline with GitHub Actions and Automated Testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/runner.js",
    "test:jest": "jest tests/api.test.js --detectOpenHandles --forceExit --runInBand",
    "test:broken": "node -e \"console.error('DELIBERATE FAILURE DEMO: Expected status 200, but test assertion received 999'); process.exit(1);\"",
    "lint": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern tests/",
    "ci": "npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
